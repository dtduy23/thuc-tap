# Sao thành .env rồi ĐỔI các mật khẩu. File .env không bao giờ được commit.

NODE_ENV=development

# API — tên riêng API_PORT, không dùng PORT chung (xem apps/api/src/cau-hinh.ts)
API_PORT=4100

# Khóa ký vé đăng nhập, dài ít nhất 32 ký tự. Máy dev bỏ trống được (API tự sinh
# khóa tạm mỗi lần chạy); production BẮT BUỘC. Tạo: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Postgres chạy bằng compose.yaml, cổng 5433 để không đụng Postgres khác trên máy.
POSTGRES_PASSWORD=doi-mat-khau-nay
# API kết nối bằng URL này. Máy dev: dùng luôn chủ bảng (API vẫn tự hạ quyền
# xuống gdos_app mỗi request). Production: role LOGIN riêng, thành viên gdos_app.
DATABASE_URL=postgres://gdos:doi-mat-khau-nay@127.0.0.1:5433/gdos
# Migration và lệnh khởi tạo chạy bằng CHỦ BẢNG. Bỏ trống thì dùng DATABASE_URL.
DATABASE_URL_CHU_BANG=

# Máy dev KHÔNG có Docker: bỏ DATABASE_URL ở trên, bật dòng dưới — API dùng
# database nhúng (PGlite) ghi ra .data/pglite, cùng migration và RLS như thật.
# Production CẤM (API từ chối khởi động).
# DB_NHUNG=1

# Lệnh khởi tạo đọc mật khẩu quản trị viên đầu tiên từ đây nếu có; không có thì hỏi ẩn.
# Chỉ đặt ở máy dev, và đặt một chuỗi ngẫu nhiên — không dùng mật khẩu thật của ai.
# GDOS_MAT_KHAU_QUAN_TRI=

# MinIO — kho tệp đính kèm (Mốc 4)
MINIO_ROOT_USER=gdos
MINIO_ROOT_PASSWORD=doi-mat-khau-minio-nay
