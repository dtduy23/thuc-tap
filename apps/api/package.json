{
  "name": "@gdos/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && pnpm run \"/^dev:/\"",
    "dev:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:node": "node scripts/chay-dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "khoi-tao": "node --env-file-if-exists=../../.env dist/cli/khoi-tao.js",
    "dat-lai-mat-khau": "node --env-file-if-exists=../../.env dist/cli/dat-lai-mat-khau.js",
    "di-tru": "node --env-file-if-exists=../../.env dist/cli/di-tru.js"
  },
  "dependencies": {
    "@gdos/shared": "workspace:*",
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/testing": "^12.1.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.0",
    "unplugin-swc": "^2.0.0"
  }
}
