{
  "name": "gdos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:shared": "pnpm --filter @gdos/shared build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @gdos/shared --filter @gdos/api --filter @gdos/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm build:shared && eslint . && node scripts/kiem-du-lieu-that.mjs",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "kiem-tra": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
